 "lines": [
  {"id": "s1a", "scene": "S1", "zh": "三十二年來，我們帶著一代又一代的華人，走遍世界。"},

  {"id": "s2a", "scene": "S2", "zh": "1994 年，溫哥華。一位剛移民的老師，在一次旅行裡，多給了導遊一份小費。"},
  {"id": "s2b", "scene": "S2", "zh": "這份善意，成了一家旅行社的起點。"},

  {"id": "s3a", "scene": "S3", "zh": "我們叫「新聯華」，取的是「心中有蓮花」。"},
  {"id": "s3b", "scene": "S3", "zh": "用真心、誠心、奉獻心，走好每一趟旅程。"},

  {"id": "s4a", "scene": "S4", "zh": "從溫哥華出發，我們把服務帶到多倫多、洛杉磯、台北和北京。"},
  {"id": "s4b", "scene": "S4", "zh": "上百家同業旅行社，都向我們調度機票。"},

  {"id": "s5a", "scene": "S5", "zh": "郵輪、歐洲、北歐、地中海、絲綢之路。"},
  {"id": "s5b", "scene": "S5", "zh": "新聯華的專業，世界通。新聯華的服務，通世界。"},

  {"id": "s6a", "scene": "S6", "zh": "用旅遊，搭起世界和平的橋樑。"},
  {"id": "s6b", "scene": "S6", "zh": "新聯華假期，XO Tours。"}
 ]
}
